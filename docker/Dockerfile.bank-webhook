# ── Stage 1: builder ─────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Copy root workspace files
COPY package.json package-lock.json turbo.json ./
COPY packages/ packages/
COPY apps/bank-webhook/ apps/bank-webhook/

# Install all dependencies
RUN npm install

# Generate Prisma client (includes native .so.node binary)
RUN npx prisma generate --schema=packages/db/prisma/schema.prisma

# Bundle the webhook app (esbuild bundles JS but not native binaries)
RUN npm run build --workspace=apps/bank-webhook

# ── Stage 2: runner ──────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Bundled JS output
COPY --from=builder /app/apps/bank-webhook/dist/index.js ./index.js

# Prisma needs its native query engine binary at runtime
# esbuild cannot bundle .so.node files so we copy them manually
COPY --from=builder /app/packages/db/src/generated ./packages/db/src/generated

EXPOSE 3003

CMD ["node", "index.js"]